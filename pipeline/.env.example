# Worker config. Shared infra credentials (DATABASE_URL, REDIS_URL, R2_*,
# WORKER_CALLBACK_SECRET, NEXT_PUBLIC_APP_URL) are read from
# ../apps/web/.env if not set here — see worker.py's load_environment().
# Only pipeline-specific settings need to live in this file.

# Public base URL the viewer fetches manifests/SOG files from, e.g. a
# custom domain in front of the R2 bucket, or its pub-<hash>.r2.dev
# subdomain. The bucket needs public read access AND CORS configured to
# allow GET from the viewer's origin — both are R2 dashboard settings,
# not something this worker can configure for you.
R2_PUBLIC_BASE_URL=""

# Overrides for this machine's tool install locations — defaults in
# worker.py match what's actually on this box (see configure_tool_paths).
# Only set these if running the worker somewhere else.
# PORTAL_GSPLAT_PYTHON="C:\tools\gsplat_train\.venv\Scripts\python.exe"
# PORTAL_VOCAB_TREE="C:\tools\vocab_tree_local_faiss_fast.bin"
# PORTAL_EXTRA_PATH_DIRS="C:\tools\colmap-3126-extract\bin;C:\tools\glomap-extract\bin"

# Where per-job scratch workdirs are created (frames, sparse model, trained
# PLYs — several GB per tour). Defaults to pipeline/work/.
# PORTAL_WORKDIR_ROOT="C:\path\to\scratch"
