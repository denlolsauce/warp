DATABASE_URL="postgresql://user:password@localhost:5432/portal?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# SMTP — used both for Auth.js magic-link sign-in and the tour-ready email.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Portal <no-reply@example.com>"

# Cloudflare R2 (S3-compatible) — bucket needs CORS configured to allow PUT
# from NEXT_PUBLIC_APP_URL with "ETag" in ExposeHeaders, or presigned
# multipart uploads from the browser can't read back each part's ETag.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Shared secret the pipeline worker sends back on job completion
# (POST /api/jobs/[id]/complete) — must match the same value the worker
# reads (pipeline/.env or apps/web/.env; see pipeline/worker.py).
WORKER_CALLBACK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_VIEWER_URL="http://localhost:5173"

# Optional S3-compatible endpoint instead of Cloudflare R2.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="false"

# Local development only. Never enabled in a production build.
ENABLE_LOCAL_DEMO="false"
# Set true behind a trusted application proxy; configure AUTH_URL for production.
AUTH_TRUST_HOST="true"
